<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildThisFileDirectory)..\Environment.props" Condition="'$(SolutionDir)' == '' And Exists('$(MSBuildThisFileDirectory)..\Environment.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{6B1C7E52-3A9D-4F0B-8C47-2D5E91A0F3B8}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>ValheimSkies</RootNamespace>
    <AssemblyName>ValheimSkies</AssemblyName>
    <TargetFrameworkVersion>v4.8.1</TargetFrameworkVersion>
    <LangVersion>12.0</LangVersion>
    <Nullable>annotations</Nullable>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <NuGetPackageImportStamp>
    </NuGetPackageImportStamp>
    <TargetFrameworkProfile />
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <StartAction>Program</StartAction>
    <StartProgram>$(VALHEIM_INSTALL)\valheim.exe</StartProgram>
    <StartArguments>-console</StartArguments>
    <StartWorkingDirectory>$(VALHEIM_INSTALL)</StartWorkingDirectory>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\Translations\English\ValheimSkies.json">
      <LogicalName>translations/English.json</LogicalName>
    </EmbeddedResource>
    <None Include="Assets\Translations\**\ValheimSkies.json" Exclude="Assets\Translations\English\ValheimSkies.json" />
    <None Include="Resources\valheim_skies" Condition="Exists('Resources\valheim_skies')" />
    <None Include="Resources\valheim_clouds" Condition="Exists('Resources\valheim_clouds')" />
    <None Include="Nexus\README.txt" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="ValheimSkiesMod.cs" />
    <Compile Include="MainConfig.cs" />
    <Compile Include="SkyCatalog.cs" />
    <Compile Include="SkyChanger.cs" />
    <Compile Include="SkyPatches.cs" />
    <Compile Include="CloudWeather.cs" />
    <Compile Include="VolumetricClouds.cs" />
    <Compile Include="WeatherPicker.cs" />
    <Compile Include="Translations.cs" />
    <Compile Include="..\Shared\ModSettings\*.cs">
      <Link>ModSettings\%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <Content Include="Package\icon.png" />
    <Content Include="Package\manifest.json" />
    <Content Include="Package\CHANGELOG.md" />
    <Content Include="Package\README.md" />
    <Content Include="UpdateManifest.ps1" Visible="false" />
    <Content Include="UpdateNexusReadme.ps1" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <None Include="app.config" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="JotunnLib">
      <Version>2.30.2</Version>
    </PackageReference>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />

  <Target Name="ReadVersion" AfterTargets="Build">
    <GetAssemblyIdentity AssemblyFiles="$(TargetPath)">
      <Output TaskParameter="Assemblies" ItemName="BuiltIdentity" />
    </GetAssemblyIdentity>
    <PropertyGroup>
      <BuiltVersion>%(BuiltIdentity.Version)</BuiltVersion>
      <PackageVersion>$(BuiltVersion.Split('.')[0]).$(BuiltVersion.Split('.')[1]).$(BuiltVersion.Split('.')[2])</PackageVersion>
      <PackageName>$(AssemblyName)_v$(PackageVersion)</PackageName>
      <ThunderPackage>$(ProjectDir)ThunderStore\$(PackageName)</ThunderPackage>
      <AssetsDir>$(ProjectDir)Assets</AssetsDir>
    </PropertyGroup>
  </Target>

  <Target Name="DeployToGame" AfterTargets="ReadVersion">
    <ItemGroup>
      <LanguageFiles Include="$(AssetsDir)\Translations\**\ValheimSkies.json" />
    </ItemGroup>
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).dll" DestinationFolder="$(MOD_DEPLOYPATH)\ValheimSkies" OverwriteReadOnlyFiles="true" />
    <Copy SourceFiles="$(ProjectDir)Resources\valheim_skies" DestinationFolder="$(MOD_DEPLOYPATH)\ValheimSkies" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="true" Condition="Exists('$(ProjectDir)Resources\valheim_skies')" />
    <Copy SourceFiles="$(ProjectDir)Resources\valheim_clouds" DestinationFolder="$(MOD_DEPLOYPATH)\ValheimSkies" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="true" Condition="Exists('$(ProjectDir)Resources\valheim_clouds')" />
    <Copy SourceFiles="@(LanguageFiles)" DestinationFiles="@(LanguageFiles->'$(MOD_CONFIGPATH)\ValheimSkies\Translations\%(RecursiveDir)%(Filename)%(Extension)')" OverwriteReadOnlyFiles="true" />
  </Target>

  <Target Name="UpdateManifestVersion" AfterTargets="DeployToGame" Condition=" '$(Configuration)' == 'Release' And '$(OS)' == 'Windows_NT' ">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)UpdateManifest.ps1&quot; -ManifestFile &quot;$(ProjectDir)Package\manifest.json&quot; -Version &quot;$(PackageVersion)&quot;" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)UpdateNexusReadme.ps1&quot; -ReadmeFile &quot;$(ProjectDir)Package\README.md&quot; -NexusFile &quot;$(ProjectDir)Nexus\README.txt&quot;" />
  </Target>

  <Target Name="MakeThunderstorePackage" AfterTargets="UpdateManifestVersion" Condition=" '$(Configuration)' == 'Release' ">
    <Error Text="Package\icon.png is missing (Thunderstore needs 256x256)." Condition="!Exists('$(ProjectDir)Package\icon.png')" />
    <Error Text="Resources\valheim_skies is missing: build it in the Unity project first." Condition="!Exists('$(ProjectDir)Resources\valheim_skies')" />
    <Error Text="Resources\valheim_clouds is missing: build it in the Unity project first (Valheim Skies > Build Clouds Bundle)." Condition="!Exists('$(ProjectDir)Resources\valheim_clouds')" />
    <ItemGroup>
      <LanguageFiles Include="$(AssetsDir)\Translations\**\ValheimSkies.json" />
      <PluginFiles Include="$(TargetDir)$(AssemblyName).dll" />
      <PluginFiles Include="$(ProjectDir)Resources\valheim_skies" />
      <PluginFiles Include="$(ProjectDir)Resources\valheim_clouds" />
      <PackageFiles Include="$(ProjectDir)Package\CHANGELOG.md;$(ProjectDir)Package\README.md;$(ProjectDir)Package\manifest.json;$(ProjectDir)Package\icon.png" />
    </ItemGroup>
    <MakeDir Directories="$(ThunderPackage)" />
    <Copy SourceFiles="@(LanguageFiles)" DestinationFiles="@(LanguageFiles->'$(ThunderPackage)\config\ValheimSkies\Translations\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(ThunderPackage)\plugins" />
    <Copy SourceFiles="@(PackageFiles)" DestinationFolder="$(ThunderPackage)" />
    <ZipDirectory SourceDirectory="$(ThunderPackage)" DestinationFile="$(ProjectDir)ThunderStore\$(PackageName).zip" Overwrite="true" />
    <RemoveDir Directories="$(ThunderPackage)" />
  </Target>
</Project>
